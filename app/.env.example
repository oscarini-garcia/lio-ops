# JSONBin.io — el documento compartido de la familia
VITE_JSONBIN_ID=your_bin_id_here
# IMPORTANTE: escapa cada $ con \$ — las claves bcrypt llevan $ y dotenv-expand los interpreta como variables
VITE_JSONBIN_KEY=\$2a\$10\$your_master_key_here

# OneSignal (opcional — sin esto la app funciona sin push)
VITE_ONESIGNAL_APP_ID=your_onesignal_app_id_here
