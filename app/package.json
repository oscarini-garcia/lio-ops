{
  "name": "lio-ops",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "cross-env CAP_BUILD=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "assets:generate": "capacitor-assets generate --ios",
    "ios:sync": "npm run build:native && cap sync ios && node scripts/patch-ios.mjs && npm run assets:generate",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capgo/capacitor-updater": "^7.0.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.2",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
